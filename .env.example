# Server Port
PORT=3000

# Environment (development | production | test)
NODE_ENV=development

# Log Level (error | warn | info | http | verbose | debug | silly)
LOG_LEVEL=info

# Email (display name used in outgoing emails)
EMAIL_FROM="Mirath" <noreply@mirath.app>

# Development SMTP (example)
# Use a sandbox provider like Mailtrap for local testing.
DEV_SMTP_HOST=sandbox.smtp.mailtrap.io
DEV_SMTP_PORT=587
DEV_SMTP_USER=your-mailtrap-username
DEV_SMTP_PASS=your-mailtrap-password

# Production SMTP (example)
PROD_SMTP_HOST=smtp.gmail.com
PROD_SMTP_PORT=465
PROD_SMTP_USER=your-production-email@example.com
PROD_SMTP_PASS=your-production-smtp-password
