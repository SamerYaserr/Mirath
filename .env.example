# Server Port
PORT=3000

# Environment (development | production | test)
NODE_ENV=development

# Log Level (error | warn | info | http | verbose | debug | silly)
LOG_LEVEL=info

# Email (display name used in outgoing emails)
EMAIL_FROM=Mirath <noreply@mirath.app>

# Development SMTP (example)
# Use a sandbox provider like Mailtrap for local testing.
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-username
SMTP_PASS=your-mailtrap-password

# Production SMTP (example)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-production-email@example.com
SMTP_PASS=your-production-smtp-password

# Postgres
POSTGRES_DB=mirath
POSTGRES_USER=mirath_user
POSTGRES_PASSWORD=mirath_pass

# Prisma DB URL
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}?schema=public

# pgAdmin Configuration
PGADMIN_EMAIL=admin@mirath.com
PGADMIN_PASSWORD=change_this_password

# JWT Configuration
JWT_ACCESS_SECRET=your-access-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-key-here
JWT_RESET_SECRET=your-reset-secret-key-here

# Expiration Configurations (in minutes/days)
OTP_EXPIRATION_MINUTES=10
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7
JWT_RESET_EXPIRATION_MINUTES=10

# Frontend URL (for CORS and redirects)
FRONTEND_URL=http://localhost:3000

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret