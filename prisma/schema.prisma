generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum UserStatus {
  PENDING_VERIFICATION
  ONBOARDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  BANNED
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
  EMAIL_CHANGE
}

enum LevelOfEducation {
  HIGH_SCHOOL
  UNDERGRADUATE
  GRADUATE
}

enum Role {
  USER
  ADMIN
}

model User {
  id               String            @id @default(uuid()) @db.Uuid
  username         String            @unique
  email            String            @unique
  password         String?
  providerId       String?
  fullName         String?
  photoUrl         String?
  bio              String?
  birthDate        DateTime?         @db.Date
  country          String?
  levelOfEducation LevelOfEducation?
  university       String?
  role             Role              @default(USER)
  status           UserStatus        @default(PENDING_VERIFICATION)
  isEmailVisible   Boolean           @default(false)
  isPremium        Boolean           @default(false)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  otpVerifications OtpVerification[]
  refreshTokens    RefreshToken[]
  userInterests    UserInterest[]
  userFields       UserField[]
  searchHistories  SearchHistory[]
  savedPapers      SavedPaper[]

  @@unique([providerId])
  @@index([email])
  @@index([username])
}

model OtpVerification {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  otpCode   String
  purpose   OtpPurpose
  expiresAt DateTime
  isUsed    Boolean    @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([otpCode])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  sessionId String   @db.Uuid
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model Interest {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  custom Boolean @default(false)

  users UserInterest[]

  @@index([name])
}

model UserInterest {
  userId     String @db.Uuid
  interestId String @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model FieldOfStudy {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  users UserField[]

  @@index([name])
}

model UserField {
  userId  String @db.Uuid
  fieldId String @db.Uuid

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  field FieldOfStudy @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([userId, fieldId])
  @@index([userId])
  @@index([fieldId])
}

model Paper {
  id String @id @default(uuid()) @db.Uuid

  citation String
  title    String
  abstract String @db.Text

  // Store as Arrays for scraping speed + GIN indexing
  authors    String[]
  categories String[]

  publishedAt DateTime

  // FOR DISPLAY
  // NEVER SEARCHED. Fetched only on "Detail View".
  content Json @db.JsonB

  // FOR SEARCHING
  // Stores stripped text (lowercase, no tags).
  // INDEXED. Used for all text queries.
  fullText String @db.Text

  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  savedPapers SavedPaper[]

  @@index([publishedAt])
  // Array Indexes (Exact Match)
  @@index([authors], type: Gin)
  @@index([categories], type: Gin)
  // Text Search Index (Fuzzy Match)
  @@index([fullText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedPaper {
  userId  String @db.Uuid
  paperId String @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, paperId])
  @@index([userId])
}
