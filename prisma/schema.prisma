generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [pg_trgm]
}

enum UserStatus {
  PENDING_VERIFICATION
  ONBOARDING
  ACTIVE
  SUSPENDED
  DEACTIVATED
  BANNED
}

enum OtpPurpose {
  REGISTER
  RESET_PASSWORD
  EMAIL_CHANGE
}

enum LevelOfEducation {
  HIGH_SCHOOL
  UNDERGRADUATE
  GRADUATE
}

enum Role {
  USER
  ADMIN
}

enum VoteType {
  UP
  DOWN
}

enum MessageRole {
  USER
  ASSISTANT
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
}

enum AttachmentType {
  IMAGE
  AUDIO
}

enum FeedbackType {
  THUMBS_UP
  THUMBS_DOWN
}

enum ColorMode {
  LIGHT
  DARK
  SYSTEM
}

enum FontSize {
  SMALL
  MEDIUM
  LARGE
  EXTRA_LARGE
}

model User {
  id                  String            @id @default(uuid()) @db.Uuid
  username            String            @unique
  email               String            @unique
  password            String?
  providerId          String?
  fullName            String?
  photoUrl            String?
  bio                 String?
  birthDate           DateTime?         @db.Date
  country             String?
  levelOfEducation    LevelOfEducation?
  university          String?
  role                Role              @default(USER)
  status              UserStatus        @default(PENDING_VERIFICATION)
  isEmailVisible      Boolean           @default(false)
  isPremium           Boolean           @default(false)
  scheduledDeletionAt DateTime?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  otpVerifications  OtpVerification[]
  refreshTokens     RefreshToken[]
  userInterests     UserInterest[]
  userFields        UserField[]
  searchHistories   SearchHistory[]
  savedPapers       SavedPaper[]
  readingLists      ReadingList[]
  discussions       Discussion[]
  comments          Comment[]
  discussionVotes   DiscussionVote[]
  commentVotes      CommentVote[]
  followers         Follows[]          @relation("follower")
  followings        Follows[]          @relation("following")
  savedReadingLists SavedReadingList[]
  readingHistories  ReadingHistory[]
  highlights        Highlight[]
  chatSessions      ChatSession[]
  messageFeedbacks  MessageFeedback[]
  chatFiles         ChatFile[]
  settings          UserSettings?

  @@unique([providerId])
  @@index([email])
  @@index([username])
}

model OtpVerification {
  id        String     @id @default(uuid()) @db.Uuid
  userId    String     @db.Uuid
  otpCode   String
  purpose   OtpPurpose
  newEmail  String? // has value only for EMAIL_CHANGE purpose
  expiresAt DateTime
  isUsed    Boolean    @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  sessionId String   @db.Uuid
  expiresAt DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([sessionId])
  @@index([expiresAt])
}

model Interest {
  id     String  @id @default(uuid()) @db.Uuid
  name   String  @unique
  custom Boolean @default(false)

  users            UserInterest[]
  discussionTopics DiscussionTopic[]

  @@index([name])
}

model UserInterest {
  userId     String @db.Uuid
  interestId String @db.Uuid

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  interest Interest @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([userId, interestId])
  @@index([userId])
  @@index([interestId])
}

model FieldOfStudy {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique

  users UserField[]

  @@index([name])
}

model UserField {
  userId  String @db.Uuid
  fieldId String @db.Uuid

  user  User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  field FieldOfStudy @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  @@id([userId, fieldId])
  @@index([userId])
  @@index([fieldId])
}

model Paper {
  id String @id @default(uuid()) @db.Uuid

  citation String
  title    String
  abstract String @db.Text

  // Store as Arrays for scraping speed + GIN indexing
  authors    String[]
  categories String[]

  publishedAt DateTime

  // FOR DISPLAY
  // NEVER SEARCHED. Fetched only on "Detail View".
  content Json @db.JsonB

  // FOR SEARCHING
  // Stores stripped text (lowercase, no tags).
  // INDEXED. Used for all text queries.
  fullText String @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedPapers       SavedPaper[]
  readingListPapers ReadingListPaper[]
  discussions       Discussion[]
  readingHistories  ReadingHistory[]
  highlights        Highlight[]

  @@index([publishedAt])
  // Array Indexes (Exact Match)
  @@index([authors], type: Gin)
  @@index([categories], type: Gin)
  // Text Search Index (Fuzzy Match)
  @@index([fullText(ops: raw("gin_trgm_ops"))], type: Gin)
}

model SearchHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  query     String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SavedPaper {
  userId  String @db.Uuid
  paperId String @db.Uuid

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, paperId])
  @@index([userId])
}

model Follows {
  followerId  String @db.Uuid
  followingId String @db.Uuid

  follower  User @relation("follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model ReadingList {
  id          String  @id @default(uuid()) @db.Uuid
  title       String
  description String? @db.Text
  isPublic    Boolean @default(true)
  ownerId     String  @db.Uuid

  owner  User               @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  papers ReadingListPaper[]

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  savedReadingLists SavedReadingList[]

  @@index([ownerId])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
}

model SavedReadingList {
  userId        String   @db.Uuid
  readingListId String   @db.Uuid
  savedAt       DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  readingList ReadingList @relation(fields: [readingListId], references: [id], onDelete: Cascade)

  @@id([userId, readingListId])
  @@index([userId])
}

model ReadingListPaper {
  readingListId String @db.Uuid
  paperId       String @db.Uuid

  readingList ReadingList @relation(fields: [readingListId], references: [id], onDelete: Cascade)
  paper       Paper       @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@id([readingListId, paperId])
}

model Discussion {
  id            String @id @default(uuid()) @db.Uuid
  title         String
  content       String @db.Text
  upvoteCount   Int    @default(0)
  downvoteCount Int    @default(0)
  commentCount  Int    @default(0)
  authorId      String @db.Uuid

  author   User              @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments Comment[]
  votes    DiscussionVote[]
  topics   DiscussionTopic[]
  papers   Paper[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([upvoteCount])
  @@index([commentCount])
  @@index([createdAt])
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([content(ops: raw("gin_trgm_ops"))], type: Gin)
}

model Comment {
  id            String  @id @default(uuid()) @db.Uuid
  content       String  @db.Text
  authorId      String  @db.Uuid
  discussionId  String  @db.Uuid
  parentId      String? @db.Uuid
  upvoteCount   Int     @default(0)
  downvoteCount Int     @default(0)

  author     User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  discussion Discussion    @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  parent     Comment?      @relation("Thread", fields: [parentId], references: [id], onDelete: Cascade)
  children   Comment[]     @relation("Thread")
  votes      CommentVote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([discussionId])
  @@index([parentId])
}

model CommentVote {
  userId    String   @db.Uuid
  commentId String   @db.Uuid
  type      VoteType

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@id([userId, commentId])
}

model DiscussionVote {
  userId       String   @db.Uuid
  discussionId String   @db.Uuid
  type         VoteType

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)

  updatedAt DateTime @updatedAt

  @@id([userId, discussionId])
}

model DiscussionTopic {
  discussionId String @db.Uuid
  interestId   String @db.Uuid

  discussion Discussion @relation(fields: [discussionId], references: [id], onDelete: Cascade)
  interest   Interest   @relation(fields: [interestId], references: [id], onDelete: Cascade)

  @@id([discussionId, interestId])
}

model ReadingHistory {
  id       String   @id @default(uuid())
  userId   String   @db.Uuid
  paperId  String   @db.Uuid
  viewedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@unique([userId, paperId])
  @@index([userId, viewedAt(sort: Desc)])
}

enum HighlightColor {
  YELLOW
  GREEN
  BLUE
  PURPLE
  PINK
  RED
}

model Highlight {
  id      String         @id @default(uuid()) @db.Uuid
  userId  String         @db.Uuid
  paperId String         @db.Uuid
  color   HighlightColor @default(YELLOW)
  note    String?

  xpathStart  String
  xpathEnd    String
  startOffset Int
  endOffset   Int

  selectedText String
  plainText    String?
  htmlContent  String?

  contextBefore      String?
  contextAfter       String?
  firstWord          String?
  lastWord           String?
  selectedWordCount  Int?
  selectedCharLength Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper Paper @relation(fields: [paperId], references: [id], onDelete: Cascade)

  @@index([userId, paperId])
  @@index([userId, paperId, createdAt])
}

model ChatSession {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String    @default("New Chat")
  isTemporary Boolean   @default(false)
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ChatMessage[]
  chatFiles ChatFile[]

  @@index([userId, updatedAt(sort: Desc)])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(uuid()) @db.Uuid
  sessionId String      @db.Uuid
  role      MessageRole
  type      MessageType @default(TEXT)
  content   String
  createdAt DateTime    @default(now())

  session     ChatSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attachments MessageAttachment[]
  feedback    MessageFeedback?

  @@index([sessionId, createdAt(sort: Asc)])
  @@map("chat_messages")
}

model MessageAttachment {
  id              String         @id @default(uuid()) @db.Uuid
  messageId       String         @db.Uuid
  type            AttachmentType
  url             String
  mimeType        String
  sizeBytes       Int
  durationSeconds Int?
  createdAt       DateTime       @default(now())

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@map("message_attachments")
}

model MessageFeedback {
  id        String       @id @default(uuid()) @db.Uuid
  messageId String       @unique @db.Uuid
  userId    String       @db.Uuid
  type      FeedbackType
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  message ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("message_feedback")
}

model ChatFile {
  id              String         @id @default(uuid()) @db.Uuid
  userId          String         @db.Uuid
  sessionId       String?        @db.Uuid
  type            AttachmentType
  url             String
  mimeType        String
  sizeBytes       Int
  durationSeconds Int?

  createdAt DateTime @default(now())

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  session ChatSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([sessionId])
  @@map("chat_files")
}

model UserSettings {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @db.Uuid

  showRecommendedPapers Boolean @default(true)
  hideAlreadyReadPapers Boolean @default(false)

  saveSearchHistory Boolean @default(true)

  colorMode       ColorMode @default(SYSTEM)
  defaultFontSize FontSize  @default(MEDIUM)

  defaultReadingListVisibility Boolean @default(true)

  annotationHighlightColors String[]

  notifyNewPapersInField    Boolean @default(true)
  notifyReadingListActivity Boolean @default(true)
  notifyNewFollowers        Boolean @default(true)
  notifyDiscussionReplies   Boolean @default(true)
  notifyCommentMentions     Boolean @default(true)
  notifyVotesOnContent      Boolean @default(true)

  isPrivateAccount                     Boolean @default(false)
  allowProfileSearch                   Boolean @default(true)
  allowPublicComments                  Boolean @default(true)
  useReadingBehaviorForRecommendations Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
