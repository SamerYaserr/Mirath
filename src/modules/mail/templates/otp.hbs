<html>
  <head>
    <meta charset='utf-8' />
    <title>Verify Your Email</title>
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <style type='text/css'>
      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      table {
        border-spacing: 0;
      }
      td {
        padding: 0;
      }
      img {
        border: 0;
        display: block;
      }
      .wrapper {
        width: 100%;
        table-layout: fixed;
        background: #ffffff;
      }
      .main {
        background: #f8f5f2; /* Same background color as welcome email */
        border-radius: 16px;
        margin: 0 auto;
        max-width: 600px;
      }
      .otp-box {
        background: #ffffff;
        border-radius: 12px;
        border: 1px dashed #d7cbc1;
        padding: 15px;
        margin: 25px 0;
        text-align: center;
        font-size: 32px;
        font-weight: 700;
        letter-spacing: 4px;
        color: #6b5a4d;
      }
    </style>
  </head>
  <body>
    <center class='wrapper'>
      <table class='main' width='100%'>
        <tr>
          <td align='center' style='padding:40px 20px;'>

            <!-- OTP Icon/Illustration -->
            <img
              src='https://your-domain.com/email-assets/lock-illustration.png'
              alt='Secure Verification'
              width='120'
              style='max-width:100%; height:auto; margin-bottom:20px;'
            />

            <!-- Heading -->
            <h1
              style='font-size:32px; line-height:1.2; font-weight:700; color:#6B5A4D; margin:0 0 20px; text-align:center;'
            >
              Verify Your Email
            </h1>

            <!-- Intro text -->
            <p
              style='font-size:16px; color:#444444; line-height:1.6; margin:16px 0; text-align:center;'
            >
              Hi there, please use the verification code below to complete your
              registration.
            </p>

            <!-- OTP Code Display -->
            <div class='otp-box'>
              {{otp}}
            </div>

            <!-- Expiry Warning -->
            <p
              style='font-size:14px; color:#888888; line-height:1.6; margin:0 0 30px; text-align:center;'
            >
              This code will expire in 10 minutes.<br />
              If you didn't request this, you can safely ignore this email.
            </p>

            <!-- Divider -->
            <hr
              style='border:none; border-top:1px solid #D7CBC1; margin:40px 0;'
            />

            <!-- Footer -->
            <p
              style='font-size:13px; color:#888888; text-align:center; line-height:1.6; margin:0;'
            >
              ©
              {{year}}
              YourAppName · All rights reserved.<br />
            </p>

          </td>
        </tr>
      </table>
    </center>
  </body>
</html>