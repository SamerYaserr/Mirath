<html>
  <head>
    <meta charset='utf-8' />
    <title>Your Account Is Scheduled for Deletion</title>
    <meta name='viewport' content='width=device-width, initial-scale=1' />
    <style type='text/css'>
      body {
        margin: 0;
        padding: 0;
        background: #ffffff;
        font-family:
          -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      }
      table {
        border-spacing: 0;
      }
      td {
        padding: 0;
      }
      img {
        border: 0;
        display: block;
      }
      .wrapper {
        width: 100%;
        table-layout: fixed;
        background: #ffffff;
      }
      .main {
        background: #f8f5f2;
        border-radius: 16px;
        margin: 0 auto;
        max-width: 600px;
      }
    </style>
  </head>
  <body>
    <center class='wrapper'>
      <table class='main' width='100%'>
        <tr>
          <td align='center' style='padding:40px 20px;'>

            <h1
              style='font-size:32px; line-height:1.2; font-weight:700; color:#6B5A4D; margin:0 0 30px; text-align:center;'
            >
              Your Account Has Been<br />Deactivated
            </h1>

            <p
              style='font-size:16px; color:#444444; line-height:1.6; margin:16px 0; text-align:center;'
            >
              Hi{{#if username}} {{username}}{{else}} there{{/if}},
            </p>

            <p
              style='font-size:16px; color:#444444; line-height:1.6; margin:16px 0; text-align:center;'
            >
              Your Mirath account has been deactivated and is scheduled for
              permanent deletion on
              <strong>{{deletionDate}}</strong>.
            </p>

            <p
              style='font-size:16px; color:#444444; line-height:1.6; margin:16px 0 40px; text-align:center;'
            >
              If you'd like to cancel this and keep your account, simply log
              back in before that date — your account will be restored
              automatically with all your data intact.
            </p>

            <p
              style='font-size:16px; color:#8C7A6B; font-weight:600; margin:30px 0; text-align:center;'
            >
              We hope to see you back soon.
            </p>

            <hr
              style='border:none; border-top:1px solid #D7CBC1; margin:40px 0;'
            />

            <p
              style='font-size:13px; color:#888888; text-align:center; line-height:1.6; margin:0;'
            >
              Need help? Reply to this email and we'll be happy to assist.<br />
              ©
              {{year}}
              Mirath · All rights reserved.
            </p>

          </td>
        </tr>
      </table>
    </center>
  </body>
</html>